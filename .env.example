# ──────────────────────────────────────────────────────────────────────────
# CareFlow — environment variable template
# Copy this file to .env.local (frontend) and .env (backend/Vercel) and fill
# in real values. NEVER commit a file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────

# Firebase (client-side, Vite — must be prefixed with VITE_)
# Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side only) — required by every /api route that
# reads/writes Firestore for an arbitrary user or verifies a Firebase ID token.
# Generate via Firebase Console → Project Settings → Service Accounts →
# Generate new private key, then base64-encode the JSON file:
#   Mac/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
# NEVER commit the raw JSON file — .gitignore already blocks *serviceAccount*.json.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Email service (server-side only, used by api/lib/mailer.js)
# Required — for Gmail, EMAIL_PASSWORD must be an App Password, not your login
# password: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional — default to Gmail's SMTP (smtp.gmail.com:587) and EMAIL_USER if unset.
# Override HOST/PORT to use a different SMTP provider (SendGrid, Mailgun, etc.)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Google Calendar OAuth (Google Cloud Console → APIs & Services → Credentials).
# CLIENT_ID is also needed client-side (OAuth client IDs are not secret) — keep
# both values identical. CLIENT_SECRET must stay server-only, never VITE_-prefixed.
# See the "Google Calendar Setup" section of README.md for full setup steps.
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gemini API key (server-side only, used by api/lib/gemini.js for the
# pre-visit and post-visit AI summaries). Get one from https://aistudio.google.com/apikey.
# Never prefix with VITE_ — it must never reach frontend code. If unset or the
# call fails, booking/completion still succeeds; the AI summary is just unavailable.
GEMINI_API_KEY=

# Optional — secret Vercel Cron sends as `Authorization: Bearer <value>` on
# scheduled invocations of api/cron/*. If unset, the cron endpoints stay
# reachable without a bearer token (fine for local testing, not for production).
CRON_SECRET=
