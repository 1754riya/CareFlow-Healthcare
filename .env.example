# Firebase (client-side, Vite — must be prefixed with VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email service (server-side only, used by api/send-appointment-confirmation.js)
# Required — for Gmail, EMAIL_PASSWORD must be an App Password, not your login password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional — default to Gmail's SMTP (smtp.gmail.com:587) and EMAIL_USER if unset.
# Override HOST/PORT to use a different SMTP provider (SendGrid, Mailgun, etc.)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Firebase Admin SDK (server-side only) — required by every /api route that reads
# or writes Firestore for an arbitrary user (Calendar tokens, appointment sync) or
# verifies a Firebase ID token. Generate via Firebase Console → Project Settings →
# Service Accounts → Generate new private key, then base64-encode the JSON file:
#   Mac/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
# NEVER commit the raw JSON file — .gitignore already blocks *serviceAccount*.json.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Calendar OAuth (Google Cloud Console → APIs & Services → Credentials).
# CLIENT_ID is also needed client-side (OAuth client IDs are not secret) — keep
# both values identical. CLIENT_SECRET must stay server-only, never VITE_-prefixed.
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gemini API key (server-side only, used by api/lib/gemini.js for the
# pre-visit symptom summary). Get one from https://aistudio.google.com/apikey.
# Never prefix with VITE_ — it must never reach frontend code. If unset or the
# call fails, booking still succeeds; the doctor just sees "AI summary unavailable".
GEMINI_API_KEY=
