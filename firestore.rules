rules_version = '2';

// CareFlow Firestore Security Rules — project careflow-7c8d3.
// Derived from how each collection is actually read/written across the
// client (src/) and server (api/, using the Admin SDK, which always
// bypasses these rules regardless of what's written here).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── doctors/{doctorId} ──────────────────────────────────────────────
    // Public directory — search (src/search/search.jsx) and the doctor
    // profile page (src/search/view.jsx) both read this unauthenticated.
    // Writes: a doctor can edit their own profile/availability
    // (src/doc-dashboard/start/Set-availability.jsx). A patient can bump
    // avgRating/totalRatings after rating a completed visit
    // (src/components/DoctorRating.jsx) — scoped to just those two fields
    // since rules can't cheaply verify "this patient had a completed
    // appointment with this doctor" without a second read. Admin-created/
    // updated doctors go through api/admin.js with the Admin SDK, which
    // bypasses this file entirely.
    match /doctors/{doctorId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.auth.uid == doctorId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avgRating', 'totalRatings'])
      );
      allow create, delete: if false;
    }

    // ── patients/{uid} ───────────────────────────────────────────────────
    // Self-service profile (signup, settings, medical records). A verified
    // doctor can also read/update a patient's doc for consultation-related
    // fields (src/doc-dashboard/PatientSidebar.jsx sets vaccinations after
    // completing a visit) — scoped to "is a doctor" rather than "is *this*
    // patient's* doctor" since that relationship isn't cheap to check here.
    match /patients/{uid} {
      allow read, update: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
      );
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── appointments/{id} ────────────────────────────────────────────────
    // Always created server-side via api/book-appointment.js (Admin SDK) —
    // client create is denied outright. Read is open to any signed-in user
    // (not just the two parties) because src/components/AppointmentBooking.jsx
    // and src/components/RescheduleModal.jsx query by doctorId alone, before
    // the viewer necessarily has a relationship to that appointment, to grey
    // out already-booked slots. Trade-off, chosen deliberately: any logged-in
    // user can see another patient's name/symptoms for a given doctor by
    // opening that doctor's booking page. Booking is still safely
    // conflict-checked server-side regardless of what the client can read.
    // Update is limited to the two parties. Patient-side updates are limited
    // to cancelling and rating (src/appointments/appointments.jsx,
    // src/components/DoctorRating.jsx); the doctor side writes broader
    // consultation fields (src/doc-dashboard/PatientSidebar.jsx) so isn't
    // field-restricted the same way.
    match /appointments/{id} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        (resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'rating'])) ||
        resource.data.doctorId == request.auth.uid
      );
      allow create, delete: if false;
    }

    // ── reviews/{id} ─────────────────────────────────────────────────────
    // Public read (shown on doctor profile pages to any visitor). A patient
    // can create their own review and edit only its rating/comment
    // (src/reviews/ReviewSystem.jsx).
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.patientId == request.auth.uid;
      allow update: if request.auth != null && resource.data.patientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if false;
    }

    // ── notifications/{id} ───────────────────────────────────────────────
    // Any authenticated user can create a notification for another user
    // (src/utils/notifications.js — e.g. a doctor notifying their patient).
    // Only the recipient can read their own, or mark it read.
    match /notifications/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── bmiHistory/{id} ──────────────────────────────────────────────────
    // Owner-only (src/bmi-tracker/BMITracker.jsx).
    match /bmiHistory/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── slotHolds/{id} ───────────────────────────────────────────────────
    // Non-sensitive (doctorId/timeSlot/expiry only) — read during booking
    // to grey out held slots (src/components/AppointmentBooking.jsx).
    // Always created/released server-side (api/hold-slot.js,
    // api/release-slot-hold.js, both Admin SDK) — no client writes.
    match /slotHolds/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── admins/{uid} ─────────────────────────────────────────────────────
    // A user may only check their own admin membership (src/AuthContext.jsx
    // gates the admin dashboard on this). Granted only via
    // scripts/grantAdmin.js with the Admin SDK — no client writes.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ── medicationReminders/{id}, emailQueue/{id} ───────────────────────
    // Server-only (api/cron.js, api/create-medication-reminders.js,
    // api/lib/emailQueue.js — all Admin SDK). No client access at all;
    // falls through to the default-deny below.

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
